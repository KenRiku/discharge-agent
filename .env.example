# Database — PostgreSQL connection string (Neon recommended for serverless)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NextAuth — Secret key for JWT signing (generate with: openssl rand -base64 32)
AUTH_SECRET=your-32-char-secret-here

# NextAuth — Full URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# OpenAI API key for the call simulation AI
OPENAI_API_KEY=sk-proj-...
